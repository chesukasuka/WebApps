    @* JS TAHUN *@
    <script>
        function onTahunChange(args) {
            var selectedYear = args.value; // tahun yang dipilih user
            var tahunya = document.getElementById("tahun").ej2_instances[0];
            console.log("Tahun Pajak dipilih =", selectedYear);

            var hasilFilter = [];
            if (parseInt(selectedYear) <= 2019) {
                hasilFilter = ["1 Tahun"];
            } else if (parseInt(selectedYear) <= 2021) {
                hasilFilter = ["1 Tahun", "3 Tahun"];
            } else {
                hasilFilter = ["1 Tahun", "3 Tahun", "5 Tahun"];
            }

            console.log("Hasil filter =", hasilFilter);

            // contoh: update dropdown lain (tahun)
            var tahunDropdown = document.getElementById("tahun").ej2_instances[0];
            tahunDropdown.dataSource = hasilFilter;
            tahunDropdown.dataBind();
            tahunya.value = null;
            tahunya.dataBind();
        }
    </script>

