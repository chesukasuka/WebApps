@using Syncfusion.EJ2
@using Syncfusion.EJ2.DropDowns
@using Syncfusion.EJ2.Inputs
@using WebApps.Models.ServiceModel;
@using WebApps.Controllers;

<link rel="stylesheet" href="~/css/controller/benchmarking.css" asp-append-version="true" />
<style>
    .custom-card {
        min-height: 5rem;
    }

    .bg-disabled {
        background-color: #0000000f !important
    }

    .btn-unduh {
        background-color: #075860;
        border-color: #075860;
        color: white;
    }

    .e-spin-down {
        display: none !important;
    }

    .e-spin-up {
        display: none !important;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #fff; /* Warna latar belakang agar header terlihat saat scroll */
        z-index: 1;
    }
</style>

@{
    ViewData["Title"] = "Simulasi Benchmarking Laporan Keuangan";
}
<div class="row custome-jumbotron">
    <div class="col-12 mb-3">
        <div class="card mb-3" style="width: 16rem; background-color: rgba(255, 255, 255, 0.12)">
            <div class="card-body d-flex">
                <a href="https://centraldataaccess.co.id">
                    <img src="~/image/service/home.svg"/>
                </a>
                <a class="fs-6 border-start border-white my-auto ms-2 ps-2 modal-hyperlink2" style="font-size:0.75rem !important; color:white" href="https://benchmarking.centraldataaccess.co.id/">
                    <span class="fst-italic">Benchmarking</span> Laporan Keuangan
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="fs-1 fw-100" style="color:white">
            Simulasi <div class="fst-italic">Benchmarking</div>
            Laporan Keuangan
        </div>
    </div>
    <div class="col-md-6 px-3">
        <p class="fs-4" style="color:white; text-align: justify">
            Kami menyediakan <span class="fst-italic">Benchmarking</span> Data Pembanding Eksternal menurut klasifikasi industri usaha (Industri Garmen, Industri Furnitur, dan Industri lainnya untuk menentukan harga <i>transfer</i>.
        </p>
    </div>
    <div class="col-12 d-none d-lg-block mt-3">
        <p class="fs-6 my-4" style="color:#93C6CE; text-align: justify">
            <span><img src="~/image/service/mouse.svg" /></span> Gulir kebawah dan gunakan demo fitur kami.
        </p>
    </div>
</div>
<div class="row py-5" style="padding-left: 2%; padding-right: 2%; background-color:#F5F9FA">
    <div class="col-md-4">
        <button type="button" class="btn btn-tosca btn-unduh">Import Excel</button>
        <div class="card mt-3" style="max-height:30rem; ">
            <div class="table-responsive">
                <table class="table table-striped table-bordered" style=" font-size: 0.9rem">
                    <thead style="color: #046D76;">
                        <tr id="grid-header">
                            <th>No</th>
                            <th>Nama File</th>
                            <th>Masa</th>
                            <th>Tahun</th>
                            <th>Jumlah Row</th>
                        </tr>
                    </thead>
                    <tbody id="grid-body">
                        @if(ViewBag.Data != null)
                        {
                            var i = 1;
                            @foreach(var row in ViewBag.Data)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@(row["NamaFile"])</td>
                                    <td>@(row["Masa"])</td>
                                    <td>@(row["Tahun"])</td>
                                    <td>@(row["JumlahRow"])</td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <button type="button" class="btn btn-tosca btn-unduh">Export XML</button>
        <div class="card mt-3" style="max-height:30rem; ">
            <div class="table-responsive">
                <table class="table table-striped table-bordered" style=" font-size: 0.9rem">
                    <thead style="color: #046D76;">
                        <tr id="grid-header">
                            <th>TaxInvoiceDate</th>
                            <th>TrxCode</th>
                            <th>AddInfo</th>
                            <th>CustomDoc</th>
                            <th>RefDesc</th>
                            <th>FacilityStamp</th>
                            <th>SellerIDTKU</th>
                            <th>BuyerTin</th>
                            <th>BuyerDocument</th>
                            <th>BuyerCountry</th>
                            <th>BuyerDocumentNumber</th>
                            <th>BuyerName</th>
                            <th>BuyerAdress</th>
                            <th>BuyerEmail</th>
                            <th>BuyerIDTKU</th>
                            <th>Opt</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Unit</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>TotalDiscount</th>
                            <th>TaxBase</th>
                            <th>OtherTaxBase</th>
                            <th>VATRate</th>
                            <th>VAT</th>
                            <th>STLGRate</th>
                            <th>STLG</th>
                        </tr>
                    </thead>
                    <tbody id="grid-body">
                        @{
                            var rand = new Random();
                        }
                        @for(var i=0; i < rand.Next(1, 30); i++){
                            <tr>
                                <td>2025-01-15</td>
                                <td>01</td>
                                <td>TD.00501</td>
                                <td>-</td>
                                <td>INV-0101</td>
                                <td>-</td>
                                <td>01234567890123456000000</td>
                                <td>01234567890123456</td>
                                <td>-</td>
                                <td>-</td>
                                <td>-</td>
                                <td>PT SUKA MAJU MENANTI</td>
                                <td>JAKARTA</td>
                                <td>-</td>
                                <td>01234567890123456000000</td>
                                <td>A</td>
                                <td>000000</td>
                                <td>Buku</td>
                                <td>UM.0003</td>
                                <td>100000</td>
                                <td>10</td>
                                <td>0</td>
                                <td>1000000</td>
                                <td>0</td>
                                <td>12</td>
                                <td>120000</td>
                                <td>0</td>
                                <td>0</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
